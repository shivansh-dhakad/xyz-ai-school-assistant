# Copy this file to ".env" in the backend/ folder and fill in your values.
# uvicorn loads it automatically on startup (see load_dotenv() in app.py).

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any chat-completion model available on Groq.
# Check https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign login JWTs. Change this to a long random string for
# anything beyond local demo use (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Voice output runs locally via ai4bharat/indic-parler-tts (backend/tts.py)
# — no API key needed. Run `python download_tts_model.py` once in backend/
# to fetch and cache the weights (a few GB) before starting the server -
# the app itself only ever loads from that local cache, it never downloads
# at runtime. Optionally override which checkpoint is used:
# INDIC_TTS_MODEL=ai4bharat/indic-parler-tts
